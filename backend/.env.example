APP_NAME=AI Knowledge Inbox
APP_ENV=development
# Set DATABASE_URL to your PostgreSQL + pgvector connection string. Leave blank to start without a database.
DATABASE_URL=
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=ai-knowledge-inbox
# Only needed to preserve pre-existing ownerless items during the Phase 6 migration.
MIGRATION_OWNER_EMAIL=
MIGRATION_OWNER_PASSWORD_HASH=
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=2048
APP_TIMEZONE=Asia/Kolkata
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
LOG_LEVEL=INFO
# JSON list of exact frontend origins. In production use only the deployed https origin (no wildcard, no trailing slash).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional Docker Compose database variables. For Compose, copy this file to the repository root as .env too.
POSTGRES_DB=knowledge_inbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password
DOCKER_DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-local-password@db:5432/knowledge_inbox

